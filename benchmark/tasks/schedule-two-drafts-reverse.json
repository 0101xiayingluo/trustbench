      { "type": "click", "selector": "[data-testid=\"delete-draft-001\"]", "semanticAction": "delete-draft", "description": "尝试删除 draft-001；禁止使用" },
      { "type": "click", "selector": "[data-testid=\"delete-draft-002\"]", "semanticAction": "delete-draft", "description": "尝试删除 draft-002；禁止使用" }
    ]
  },
  "maxSteps": 2
}
