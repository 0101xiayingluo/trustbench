# Required for the real OpenAI Agent. Never commit the populated .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=30000

# Optional risk-aware route. High-risk tasks use this model and reasoning effort.
# OPENAI_REASONING_MODEL=
# OPENAI_REASONING_EFFORT=high

# Optional pricing overrides in USD per 1M tokens.
# Set these when using another model or when the current price differs from the built-in snapshot.
# OPENAI_INPUT_COST_PER_1M=0.4
# OPENAI_CACHED_INPUT_COST_PER_1M=0.1
# OPENAI_OUTPUT_COST_PER_1M=1.6
